# hackster.pcf — Pin constraints for CSAW26 Trojan on iCE40-UP5K (Hackster board)
# Derived from kiwih/hackster-programmer examples/spi_les/ and examples/spi_aes/

# Clock
set_io SCK        36    # D0 — unified system + SPI clock (max 1 MHz)
set_frequency SCK 1

# LED
set_io ICE_LED    38    # mirrors BUSY

# SPI data
set_io MOSI       32    # D2 — serial data in
set_io MISO       31    # D3 — serial data out
set_io NORM_CS_N  28    # D4 — chip select (active low)

# Control
set_io RST_N      34    # D1 — synchronous reset (active low)
set_io START      27    # D6 — start encrypt/decrypt
set_io ENC_DEC    25    # D7 — 0=encrypt, 1=decrypt
set_io BUSY       23    # D8 — processing status
